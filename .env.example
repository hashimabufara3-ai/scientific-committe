# Supabase (copy to .env.local and fill in your project values)
# Project URL from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose in the browser; never use the service_role key here).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, never expose to client components or logs.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for email redirect links). Required in production.
# Example: https://ptuksc.com
NEXT_PUBLIC_SITE_URL=

# Upstash Redis (rate limiting). Get from https://console.upstash.com
# Server-only — never prefix with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry error tracking (P1-1A). Error capture is enabled only when a DSN is
# set, so local development stays isolated. Set both in the production host
# (Render) only.
# DSN from Sentry > Settings > Projects > [project] > Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Environment label reported to Sentry, e.g. "production" (default).
SENTRY_ENVIRONMENT=

# Origin-access secret for the Render origin (server-only; never NEXT_PUBLIC_).
# Cloudflare injects this value as the X-Origin-Access-Secret request header on
# requests forwarded to Render. The Next.js proxy rejects any production
# request that reaches the Render origin without the matching header, so direct
# access to the *.onrender.com hostname is blocked. Leave empty in local dev;
# set the SAME strong value here/on Render and in the Cloudflare Transform Rule.
ORIGIN_ACCESS_SECRET=
