# Supabase (copy to .env.local and fill in your project values)
# Project URL from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose in the browser; never use the service_role key here).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, never expose to client components or logs.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for email redirect links). Required in production.
# Example: https://ptuksc.com
NEXT_PUBLIC_SITE_URL=

# Upstash Redis (rate limiting). Get from https://console.upstash.com
# Server-only — never prefix with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry error tracking (P1-1A). Error capture is enabled only when a DSN is
# set, so local development stays isolated. Set both in the production host
# (Render) only.
# DSN from Sentry > Settings > Projects > [project] > Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Environment label reported to Sentry, e.g. "production" (default).
SENTRY_ENVIRONMENT=

# Outbound transactional email (Phase 0) — server-only, NEVER prefix with NEXT_PUBLIC_.
# Provider: Resend (https://resend.com). Create an API key in the Resend dashboard.
# This is a placeholder — set your real key in .env.local / the deploy host only.
RESEND_API_KEY=

# Verified "From" address for transactional mail. Must match a sending identity
# you verify in Resend (domain-level verification is recommended, e.g. mail.ptuksc.com).
# Example: "PTUK Scientific Committee <noreply@mail.ptuksc.com>"
EMAIL_FROM_ADDRESS=

# Set to "true" to enable real outbound sends. Any other value disables email
# (sendEmail returns { ok: false, reason: "disabled" }) — a safe default.
EMAIL_ENABLED=
